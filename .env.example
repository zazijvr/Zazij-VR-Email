# Zkopírujte do .env a doplňte hodnoty (.env se do gitu nenahrává)
VITE_GOOGLE_CLIENT_ID_DESKTOP=
VITE_GOOGLE_CLIENT_ID_MOBILE=
VITE_GOOGLE_CLIENT_SECRET=
