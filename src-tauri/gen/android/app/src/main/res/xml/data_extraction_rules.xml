<?xml version="1.0" encoding="utf-8"?>
<!-- Žádná data aplikace (vault.bin s tokeny a hesly k IMAP účtům) do záloh Google ani do přenosu
     na nový telefon – po přenosu se účty přihlásí znovu. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
